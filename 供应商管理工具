<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>供应商管理工具</title>
<style>
  :root{--navy:#12233f;--blue:#276ef1;--ink:#162033;--muted:#6d7788;--line:#e7ebf1;--bg:#f5f7fb;--green:#16845b;--amber:#bd7800;--red:#c94242}
  *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 "Microsoft YaHei","PingFang SC",Arial,sans-serif}
  header{height:72px;background:var(--navy);display:flex;align-items:center;justify-content:space-between;padding:0 36px;color:white}.brand{font-size:20px;font-weight:700;letter-spacing:.5px}.brand small{display:block;color:#aebdd5;font-size:12px;font-weight:400;margin-top:2px}.header-actions{display:flex;gap:10px;align-items:center}.header-actions span{font-size:12px;color:#c5d1e6}
  button{border:0;border-radius:7px;padding:9px 14px;cursor:pointer;font:inherit;font-weight:600;transition:.15s}button:hover{filter:brightness(.96)}.primary{background:var(--blue);color:#fff}.ghost{background:#fff;color:#27364f}.outline{background:#fff;border:1px solid #d9e0e9;color:#3e4d63}.danger{color:var(--red);background:#fff0f0}.small{padding:6px 9px;font-size:12px}
  main{max-width:1440px;margin:0 auto;padding:28px 34px 38px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}.stat{background:#fff;border:1px solid var(--line);border-radius:10px;padding:17px 19px}.stat .label{color:var(--muted);font-size:12px}.stat .value{font-size:25px;font-weight:700;margin-top:5px}.stat .hint{font-size:12px;color:var(--green);margin-top:3px}
  .panel{background:#fff;border:1px solid var(--line);border-radius:10px;margin-top:18px;overflow:hidden}.panel-title{padding:18px 20px 12px;font-size:16px;font-weight:700}.toolbar{padding:4px 20px 17px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar input,.toolbar select{height:37px;border:1px solid #d9e0e9;border-radius:7px;padding:0 10px;color:var(--ink);background:#fff}.toolbar input{width:300px}.toolbar .push{margin-left:auto}
  table{border-collapse:collapse;width:100%;min-width:1050px}th{text-align:left;background:#f8fafc;color:#647187;font-size:12px;font-weight:600;padding:11px 13px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}td{padding:13px;border-bottom:1px solid var(--line);vertical-align:middle}.table-wrap{overflow-x:auto}tbody tr:hover{background:#fbfcfe}.supplier-name{font-weight:700}.sub{font-size:12px;color:var(--muted);margin-top:2px}.badge{display:inline-block;border-radius:99px;padding:3px 8px;font-size:12px;font-weight:600}.active{background:#e8f7ef;color:var(--green)}.trial{background:#fff4dc;color:var(--amber)}.paused{background:#eef1f5;color:#6b7582}.stars{color:#e5a400;letter-spacing:1px;white-space:nowrap}.muted{color:var(--muted)}
  .compare-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 8px}.compare-desc{color:var(--muted);font-size:12px;padding:0 20px 15px}.winner{color:var(--green);font-weight:700}.empty{padding:30px;text-align:center;color:var(--muted)}
  dialog{border:0;border-radius:12px;box-shadow:0 18px 55px #16203355;padding:0;width:min(760px,calc(100% - 30px);max-height:90vh}dialog::backdrop{background:#15233b77}.modal-title{padding:20px 24px;border-bottom:1px solid var(--line);font-size:18px;font-weight:700}.form{padding:22px 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:#5d687a;font-weight:600}.field input,.field select,.field textarea{border:1px solid #d6dee9;border-radius:7px;padding:9px 10px;font:inherit;color:var(--ink);width:100%}.field textarea{min-height:75px;resize:vertical}.modal-actions{padding:0 24px 22px;display:flex;justify-content:space-between;align-items:center}.modal-actions .right{display:flex;gap:9px}.note{font-size:12px;color:var(--muted)}
  @media(max-width:850px){header{padding:0 18px}main{padding:20px 15px}.stats{grid-template-columns:repeat(2,1fr)}.toolbar input{width:100%}.toolbar .push{margin-left:0}.form{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style>
</head>
<body>
<header><div class="brand">供应商管理工具<small>跨境电商供应链工作台 · 本地数据版</small></div><div class="header-actions"><span id="saveStatus">数据保存在此浏览器</span><button class="ghost small" id="resetBtn">恢复演示数据</button><button class="primary" id="addBtn">+ 新增供应商</button></div></header>
<main>
  <section class="stats"><div class="stat"><div class="label">供应商总数</div><div class="value" id="totalCount">0</div><div class="hint">已建档供应商</div></div><div class="stat"><div class="label">合作中</div><div class="value" id="activeCount">0</div><div class="hint">当前稳定合作</div></div><div class="stat"><div class="label">平均评分</div><div class="value" id="avgRating">0.0</div><div class="hint">满分 5.0</div></div><div class="stat"><div class="label">最低报价</div><div class="value" id="lowestPrice">—</div><div class="hint">当前筛选数据中</div></div></section>
  <section class="panel"><div class="panel-title">供应商列表</div><div class="toolbar"><input id="search" placeholder="搜索供应商、产品、地区或备注"><select id="statusFilter"><option value="">全部合作状态</option><option>合作中</option><option>试单中</option><option>暂停合作</option></select><select id="ratingFilter"><option value="">全部评分</option><option value="4">4 分及以上</option><option value="3">3 分及以上</option></select><button class="outline small" id="clearFilter">清除筛选</button><button class="outline small push" id="exportBtn">导出备份</button><label class="outline small" style="cursor:pointer">导入备份<input id="importInput" type="file" accept="application/json" hidden></label></div><div class="table-wrap"><table><thead><tr><th>供应商 / 联系人</th><th>产品与报价</th><th>MOQ</th><th>交期</th><th>合作状态</th><th>评分</th><th>备注</th><th>操作</th></tr></thead><tbody id="supplierBody"></tbody></table></div></section>
  <section class="panel"><div class="compare-head"><div class="panel-title" style="padding:0">报价 / 成本对比</div><select id="productFilter"><option value="">全部产品</option></select></div><div class="compare-desc">总采购成本 = 单价 × MOQ。可用产品筛选同款报价，绿色标记为当前最低总采购成本。</div><div class="table-wrap"><table><thead><tr><th>供应商</th><th>产品</th><th>单价（元）</th><th>MOQ</th><th>最低起订总成本（元）</th><th>交期</th><th>说明</th></tr></thead><tbody id="compareBody"></tbody></table></div></section>
</main>
<dialog id="supplierDialog"><div class="modal-title" id="modalHeading">新增供应商</div><form class="form" id="supplierForm"><input type="hidden" id="supplierId"><div class="field"><label>供应商名称 *</label><input id="name" required placeholder="例如：深圳优品工厂"></div><div class="field"><label>联系人</label><input id="contact" placeholder="姓名 / 电话 / 邮箱"></div><div class="field"><label>产品名称 *</label><input id="product" required placeholder="例如：不锈钢保温杯"></div><div class="field"><label>报价（元 / 件） *</label><input id="price" type="number" min="0" step="0.01" required placeholder="0.00"></div><div class="field"><label>MOQ（件） *</label><input id="moq" type="number" min="1" required placeholder="例如：300"></div><div class="field"><label>交期（天） *</label><input id="leadTime" type="number" min="0" required placeholder="例如：15"></div><div class="field"><label>合作状态</label><select id="status"><option>合作中</option><option>试单中</option><option>暂停合作</option></select></div><div class="field"><label>供应商评分（1–5）</label><select id="rating"><option value="5">5 - 优秀</option><option value="4">4 - 良好</option><option value="3">3 - 一般</option><option value="2">2 - 待改善</option><option value="1">1 - 风险较高</option></select></div><div class="field"><label>所在地</label><input id="location" placeholder="例如：广东 · 深圳"></div><div class="field"><label>更新时间</label><input id="updatedAt" type="date"></div><div class="field full"><label>备注</label><textarea id="notes" placeholder="可记录打样情况、付款方式、质检问题或下次跟进事项"></textarea></div></form><div class="modal-actions"><button type="button" class="danger small" id="deleteBtn" hidden>删除供应商</button><div class="right"><button type="button" class="outline" id="cancelBtn">取消</button><button type="submit" form="supplierForm" class="primary">保存供应商</button></div></div></dialog>
<script>
const KEY='supplier-management-tool-v1';
const demo=[
 {id:'demo-1',name:'华南家居用品厂',contact:'陈经理 · 138****2018',product:'不锈钢保温杯',price:22.8,moq:300,leadTime:15,status:'合作中',rating:5,location:'广东 · 深圳',updatedAt:'2026-08-10',notes:'现有主力供应商；支持常规包装定制。'},
 {id:'demo-2',name:'义乌优选贸易',contact:'王小姐 · 139****5826',product:'不锈钢保温杯',price:21.5,moq:500,leadTime:12,status:'试单中',rating:4,location:'浙江 · 义乌',updatedAt:'2026-08-08',notes:'报价较低，需确认样品与质检标准。'},
 {id:'demo-3',name:'东莞智造礼品厂',contact:'刘先生 · 137****6942',product:'硅胶厨房套装',price:18.9,moq:200,leadTime:20,status:'合作中',rating:4,location:'广东 · 东莞',updatedAt:'2026-08-06',notes:'交期稳定；适合小批量补货。'},
 {id:'demo-4',name:'宁波海拓进出口',contact:'周经理 · 136****3309',product:'旅行收纳袋',price:9.6,moq:1000,leadTime:25,status:'暂停合作',rating:3,location:'浙江 · 宁波',updatedAt:'2026-07-28',notes:'上次批次颜色偏差，待改善后复审。'}
];
let suppliers=load(); let editingId=null;
const $=id=>document.getElementById(id); const money=n=>'¥'+Number(n).toLocaleString('zh-CN',{minimumFractionDigits:2,maximumFractionDigits:2});
function load(){try{const data=JSON.parse(localStorage.getItem(KEY));return Array.isArray(data)?data:demo}catch{return demo}}
function save(){localStorage.setItem(KEY,JSON.stringify(suppliers));$('saveStatus').textContent='已保存到此浏览器';setTimeout(()=>$('saveStatus').textContent='数据保存在此浏览器',1600)}
function esc(v=''){return String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function filtered(){const q=$('search').value.trim().toLowerCase(),status=$('statusFilter').value,min=+$('ratingFilter').value;return suppliers.filter(s=>{const words=[s.name,s.contact,s.product,s.location,s.notes].join(' ').toLowerCase();return (!q||words.includes(q))&&(!status||s.status===status)&&(!min||s.rating>=min)})}
function badge(s){return '<span class="badge '+(s==='合作中'?'active':s==='试单中'?'trial':'paused')+'">'+s+'</span>'}
function render(){const rows=filtered();$('supplierBody').innerHTML=rows.length?rows.map(s=>`<tr><td><div class="supplier-name">${esc(s.name)}</div><div class="sub">${esc(s.contact||'未填写联系人')} · ${esc(s.location||'未填写地区')}</div></td><td><b>${esc(s.product)}</b><div class="sub">${money(s.price)} / 件</div></td><td>${Number(s.moq).toLocaleString()} 件</td><td>${s.leadTime} 天</td><td>${badge(s.status)}</td><td><span class="stars">${'★'.repeat(s.rating)}${'☆'.repeat(5-s.rating)}</span><div class="sub">${s.rating}.0 / 5.0</div></td><td class="muted">${esc(s.notes||'—')}</td><td><button class="outline small" onclick="editSupplier('${s.id}')">编辑</button></td></tr>`).join(''):'<tr><td colspan="8" class="empty">没有找到符合条件的供应商</td></tr>';
 $('totalCount').textContent=suppliers.length;$('activeCount').textContent=suppliers.filter(s=>s.status==='合作中').length;$('avgRating').textContent=suppliers.length?(suppliers.reduce((a,s)=>a+ +s.rating,0)/suppliers.length).toFixed(1):'0.0';$('lowestPrice').textContent=rows.length?money(Math.min(...rows.map(s=>+s.price))):'—';renderProductOptions();renderCompare();}
function renderProductOptions(){const chosen=$('productFilter').value,products=[...new Set(suppliers.map(s=>s.product).filter(Boolean))];$('productFilter').innerHTML='<option value="">全部产品</option>'+products.map(p=>'<option '+(p===chosen?'selected':'')+'>'+esc(p)+'</option>').join('')}
function renderCompare(){const product=$('productFilter').value;const rows=suppliers.filter(s=>!product||s.product===product);const costs=rows.map(s=>+s.price*+s.moq);const min=Math.min(...costs);$('compareBody').innerHTML=rows.length?rows.map(s=>{const cost=+s.price*+s.moq;return `<tr><td><b>${esc(s.name)}</b></td><td>${esc(s.product)}</td><td>${money(s.price)}</td><td>${Number(s.moq).toLocaleString()} 件</td><td class="${cost===min?'winner':''}">${money(cost)}${cost===min?' · 最低':''}</td><td>${s.leadTime} 天</td><td class="muted">${esc(s.notes||'—')}</td></tr>`}).join(''):'<tr><td colspan="7" class="empty">暂无可比较的报价</td></tr>'}
function openDialog(s){editingId=s?.id||null;$('modalHeading').textContent=s?'编辑供应商':'新增供应商';$('deleteBtn').hidden=!s;['name','contact','product','price','moq','leadTime','status','rating','location','updatedAt','notes'].forEach(k=>$(k).value=s?.[k]??(k==='updatedAt'?new Date().toISOString().slice(0,10):''));$('supplierDialog').showModal()}
window.editSupplier=id=>openDialog(suppliers.find(s=>s.id===id));
$('addBtn').onclick=()=>openDialog();$('cancelBtn').onclick=()=>$('supplierDialog').close();$('deleteBtn').onclick=()=>{if(confirm('确定删除该供应商吗？')){suppliers=suppliers.filter(s=>s.id!==editingId);save();render();$('supplierDialog').close()}};
$('supplierForm').onsubmit=e=>{e.preventDefault();const obj={id:editingId||'s-'+Date.now()};['name','contact','product','price','moq','leadTime','status','rating','location','updatedAt','notes'].forEach(k=>obj[k]=['price','moq','leadTime','rating'].includes(k)?Number($(k).value):$(k).value.trim());if(editingId){suppliers=suppliers.map(s=>s.id===editingId?obj:s)}else{suppliers.unshift(obj)}save();render();$('supplierDialog').close()};
[$('search'),$('statusFilter'),$('ratingFilter')].forEach(el=>el.addEventListener('input',render));$('productFilter').onchange=renderCompare;$('clearFilter').onclick=()=>{$('search').value='';$('statusFilter').value='';$('ratingFilter').value='';render()};
$('resetBtn').onclick=()=>{if(confirm('恢复演示数据会覆盖当前浏览器中的所有供应商数据，确定继续吗？')){suppliers=demo.map(x=>({...x}));save();render()}};
$('exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(suppliers,null,2)],{type:'application/json'}));a.download='供应商管理备份_'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)};
$('importInput').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const data=JSON.parse(r.result);if(!Array.isArray(data))throw 0;suppliers=data;save();render();alert('备份导入成功。')}catch{alert('文件格式不正确，未导入。')}};r.readAsText(f);e.target.value=''};
render();
</script></body></html>

</style>
</head>
